# Upstream FinLedger Engine. The Next.js route handler at
# /api/backend/[...path] proxies to this URL server-to-server.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Demo wallet owner and merchant used by the kiosk.
NEXT_PUBLIC_OWNER_ID=demo-customer
NEXT_PUBLIC_MERCHANT_ID=merch-001

# Set to "true" to call the upstream directly from the browser instead of
# through the proxy. Requires the backend to allow this origin via CORS.
# NEXT_PUBLIC_API_DIRECT=false
